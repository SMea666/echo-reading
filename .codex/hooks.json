{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/progress-reminder-codex.sh\"",
            "statusMessage": "Checking reading progress reminder",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/insight-reminder-codex.sh\"",
            "statusMessage": "Checking insight reminder",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/auto-push.sh\"",
            "statusMessage": "Auto-pushing to remote",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/slack-milestone.sh\"",
            "statusMessage": "Sending Slack milestone",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shellcheck-hook.sh\"",
            "statusMessage": "Running shellcheck",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
